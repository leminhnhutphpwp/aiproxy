# Server
PORT=4097
HOSTNAME=127.0.0.1
NODE_ENV=production
CORS_ORIGIN=*

# Dashboard login (dashboard is disabled when DASHBOARD_USER is empty)
DASHBOARD_USER=admin
DASHBOARD_PASS=

# Client auth for /v1/*. Clients send HTTP Basic with these credentials.
# Set both: when either is empty, Basic auth is refused.
OPENCODE_USERNAME=
OPENCODE_PASSWORD=

# Optional OpenCode server used as the default provider pool
OPENCODE_URL=http://127.0.0.1:4096

# Optional external API-key portal. When INTERNAL_API_SECRET is set, clients may
# send "Authorization: Bearer <key>" and the key is checked at
# $PORTAL_BASE_URL/api/internal/validate-key.
PORTAL_BASE_URL=http://127.0.0.1:3000
INTERNAL_API_SECRET=

# Upstream provider keys referenced by config/direct-providers.json
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
GITHUB_TOKEN=

# Embeddings for the memory / specialized-knowledge features (optional)
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# Optional catalog directory with models.override.json and a sync script
CATALOG_ROOT=
